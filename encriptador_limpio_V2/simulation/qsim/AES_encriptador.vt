initial 

begin 
$timeformat(-12,3," ps",6);
#10000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module main_AES_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [1:0] AES_version;
reg clk;
reg reset;
reg start;
// wires                                               
wire [127:0] ciphertext_out;
wire done_o;
wire [3:0] index_out;
wire [7:0] sbox_out_test;
wire [2:0] state_out;
wire [127:0] sub_text_out;

wire sampler;                             

// assign statements (if any)                          
main_AES i1 (
// port map - connection between master ports and signals/registers   
	.AES_version(AES_version),
	.ciphertext_out(ciphertext_out),
	.clk(clk),
	.done_o(done_o),
	.index_out(index_out),
	.reset(reset),
	.sbox_out_test(sbox_out_test),
	.start(start),
	.state_out(state_out),
	.sub_text_out(sub_text_out)
);

// clk
always
begin
	clk = 1'b0;
	clk = #25000 1'b1;
	#25000;
end 
// AES_version[ 1 ]
initial
begin
	AES_version[1] = 1'b0;
end 
// AES_version[ 0 ]
initial
begin
	AES_version[0] = 1'b1;
end 

// reset
initial
begin
	reset = 1'b1;
end 

// start
initial
begin
	start = 1'b0;
	start = #320000 1'b1;
	start = #160000 1'b0;
end 

main_AES_vlg_sample_tst tb_sample (
	.AES_version(AES_version),
	.clk(clk),
	.reset(reset),
	.start(start),
	.sampler_tx(sampler)
);

main_AES_vlg_check_tst tb_out(
	.ciphertext_out(ciphertext_out),
	.done_o(done_o),
	.index_out(index_out),
	.sbox_out_test(sbox_out_test),
	.state_out(state_out),
	.sub_text_out(sub_text_out),
	.sampler_rx(sampler)
);
endmodule

