initial 

begin 
$timeformat(-12,3," ps",6);
#10000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module lorenz_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [1:0] AES_version;
reg clk;
reg reset;
reg start;
// wires                                               
wire [1:0] counter_out;
wire [31:0] data_out;
wire data_valid;
wire done_out;
wire [3:0] ram_addr;

wire sampler;                             

// assign statements (if any)                          
lorenz i1 (
// port map - connection between master ports and signals/registers   
	.AES_version(AES_version),
	.clk(clk),
	.counter_out(counter_out),
	.data_out(data_out),
	.data_valid(data_valid),
	.done_out(done_out),
	.ram_addr(ram_addr),
	.reset(reset),
	.start(start)
);

// clk
always
begin
	clk = 1'b0;
	clk = #25000 1'b1;
	#25000;
end 

// reset
initial
begin
	reset = 1'b1;
end 

// start
initial
begin
	start = 1'b0;
	start = #320000 1'b1;
	start = #160000 1'b0;
end 
// AES_version[ 1 ]
initial
begin
	AES_version[1] = 1'b0;
end 
// AES_version[ 0 ]
initial
begin
	AES_version[0] = 1'b0;
end 

lorenz_vlg_sample_tst tb_sample (
	.AES_version(AES_version),
	.clk(clk),
	.reset(reset),
	.start(start),
	.sampler_tx(sampler)
);

lorenz_vlg_check_tst tb_out(
	.counter_out(counter_out),
	.data_out(data_out),
	.data_valid(data_valid),
	.done_out(done_out),
	.ram_addr(ram_addr),
	.sampler_rx(sampler)
);
endmodule

