`timescale 1 ps/ 1 ps
module lorenz_vlg_sample_tst(
	AES_version,
	clk,
	reset,
	start,
	sampler_tx
);
input [1:0] AES_version;
input  clk;
input  reset;
input  start;
output sampler_tx;

reg sample;
time current_time;
always @(AES_version or clk or reset or start)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

