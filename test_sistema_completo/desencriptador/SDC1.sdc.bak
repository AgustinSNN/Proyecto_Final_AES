# 50 MHz clock - 20ns period
create_clock -name clk -period 20.000 [get_ports {clk}]

# Derived clocks (add these if you use PLLs)
# derive_pll_clocks

# Automatically calculate clock uncertainty
derive_clock_uncertainty

# Relax I/O delays - adjust later if you care about board timing
set_input_delay  -clock clk -max 2.000 [all_inputs]
set_output_delay -clock clk -max 2.000 [all_outputs]