library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;
 
entity controlador is
  port (
    clk       		 : in  std_logic;
	 reset 			 : in  std_logic;
    data_valid     : in  std_logic;
    data_in		    : in  std_logic_vector(7 downto 0);
	 data_out		 : out std_logic_vector(7 downto 0)
    );
end controlador;
 
 
architecture RTL of controlador is

	component sampler is
    port(
        clk         : in  std_logic;
        reset       : in  std_logic;
        data_in     : in  std_logic_vector(7 downto 0);
        data_valid  : in  std_logic;
		  start		  : in  std_logic;
		  data_out	  : out std_logic_vector(127 downto 0);
        full        : out std_logic
    );
	end component;
	
	component UART_RX is
	generic (
		g_CLKS_PER_BIT : integer := 434     -- Needs to be set correctly
		);
	port (
		i_Clk       : in  std_logic;
		i_RX_Serial : in  std_logic;
		o_RX_DV     : out std_logic;
		o_RX_Byte   : out std_logic_vector(7 downto 0)
		);
	end component;
	

	type state_t is (IDLE, READ_COMAND, FILL_BUFFER, DONE);
	signal state : state_t := IDLE;
	
	signal data_in_reg : std_logic_vector(7 downto 0);
	
	signal start : std_logic;
	signal enable_key : std_logic;
	
	
	
	
begin

	
	process(clk, data_valid, data_in)
	begin
	
		if reset = '1' then
			state <= IDLE;
		elsif rising_edge(clk) then
			if data_valid ='1' then
				data_in_reg <= data_in;
			end if;
			
			case state is
				
				when IDLE =>
					start <= '0';
					if data_valid = '0' then
						state <= IDLE;
					else
						state <= READ_COMAND;
					end if;
					
				when READ_COMAND =>
					if data_in = "11000011" then
						enable_key <= '1'
						state <= FILL_BUFFER;
						start = '1';
					elsif data_in = "10101010";
						
					else
						state <= IDLE;
					end if;
				
				when FILL_BUFFER =>
					start <= '0';
					enable_key <= '1';
					if fill_done = '0' then
						state <= FILL_BUFFER;
					else
						state <= DONE;
					end if;
					
					if data_valid '1' then
						data_valid_out <= '1';
					else
						data_valid_out <= '0';
					end if;
					
				when DONE =>
					enable_key <= '0';
					state <= IDLE;
					
			end case;
		end if;
	end process;
end architecture;
						